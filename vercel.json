{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@0.7.4"
    }
  },
  "rewrites": [
    { "source": "/simulation/(.*)", "destination": "/api/index.py" },
    { "source": "/lean/(.*)", "destination": "/api/index.py" },
    { "source": "/logs", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}

